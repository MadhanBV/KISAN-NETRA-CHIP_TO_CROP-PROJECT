# CHIP TO CROP - Backend Environment Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to version control.

# Face++ Compare API Configuration
# Get your API key and secret from https://console.faceplusplus.com
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_COMPARE_URL=https://api-us.faceplusplus.com/facepp/v3/compare
FACEPP_CONFIDENCE_THRESHOLD=80.0

# JWT Authentication
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Configuration (Backend use only - never expose in client applications)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key_here

# Sarvam AI Configuration (Backend use only - never expose in client applications)
# Text translation, and future Speech-to-Text & Text-to-Speech
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=False
MAX_FAILED_LOGIN_ATTEMPTS=3

# Open Government Data (data.gov.in) Configuration (Backend use only)
# Get your API key from https://data.gov.in
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
