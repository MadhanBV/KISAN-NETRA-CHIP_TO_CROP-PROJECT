# CHIP TO CROP - Environment Configuration Template
# Copy this file to .env and provide your actual API keys and backend endpoints.
# NEVER commit the real .env file with production credentials to version control.

# FastAPI Backend Configuration
BACKEND_BASE_URL=https://api.chiptocrop.example.com
BACKEND_WS_URL=wss://api.chiptocrop.example.com/ws
API_TIMEOUT_SECONDS=30

# Supabase Configuration (Backend use only - never expose secret key in Flutter)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key_here

# Weather API (Planned integration)
WEATHER_API_BASE_URL=https://api.weatherapi.example.com
WEATHER_API_KEY=your_weather_api_key_here

# Government Mandi Prices API (Agmarknet / e-NAM)
MANDI_API_BASE_URL=https://api.data.gov.in/resource/
MANDI_API_KEY=your_mandi_api_key_here

# Sarvam AI (Planned for Kannada, English, Telugu, Tamil Speech & Translation)
SARVAM_API_KEY=your_sarvam_api_key_here
